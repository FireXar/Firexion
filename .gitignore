# ==============================================================================
# .gitignore - ADMcgh (Repositorio Limpio)
# ==============================================================================

# Archivos de respaldo y comprimidos
*.zip
*.tar
*.tar.gz
*.tgz
.raw_unpacked/
.backup/

# Python y caché
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Archivos de sistema / temporales
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.orig
error.log
log.txt
lista-arq
lista*

# Credenciales y secretos
.env
*.pem
id_rsa*
token.sh
