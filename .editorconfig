root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false
indent_style = space
indent_size = 4

# Los .sh son artefactos de auditoría: se conservan tal cual salieron del volcado
[*.sh]
trim_trailing_whitespace = false
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
